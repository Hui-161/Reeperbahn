/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://tile.openstreetmap.org https://www.reeperbahnfestival.com; connect-src 'self'; font-src 'self'; frame-src https://open.spotify.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# Vendor-Dateien tragen KEINE Version im Namen. "immutable" waere hier eine
# Falle: nach einer Aktualisierung haengen Besucher ein Jahr auf der alten
# Fassung. Ein Tag mit Revalidierung ist billig (ETag) und sicher.
/vendor/*
  Cache-Control: public, max-age=86400, must-revalidate

# Die App-Huelle traegt ebenfalls keine Version im Namen - also immer
# revalidieren, sonst entstehen gemischte Staende aus alten und neuen Dateien.
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/style.css
  Cache-Control: no-cache

# Programmdaten aendern sich taeglich.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# Der Service Worker darf NIE lange gecacht werden, sonst haengt die App
# auf einer alten Version fest.
/sw.js
  Cache-Control: no-cache

# --- Einstellungen der Pebble-App (Repo Hui-161/Pebble) ---
#
# Cloudflare fuehrt gleichnamige Kopfzeilen ZUSAMMEN (mit Komma), es gilt
# nicht "die genauere Regel gewinnt". Eine zweite CSP hier wuerde sich also
# an die aus /* haengen, und ein Browser wertet zwei CSP-Regeln als
# Schnittmenge - die Seite waere genauso blockiert wie ohne diesen Block.
# Deshalb erst entfernen ("! "), dann neu setzen. Das setzt voraus, dass
# dieser Block NACH der Regel fuer /* steht.
#
# Einziger Unterschied zur Regel unter /*: connect-src erlaubt zusaetzlich
# accounts.spotify.com. Ohne das schlaegt der Tausch des Anmeldecodes gegen
# den Token fehl - und zwar lautlos, wie CSP-Blockaden es tun.
#
# Der Rest der Seite braucht die Ausnahme NICHT: Team-ID, Name und
# Passphrase funktionieren auch unter der Regel fuer /*. Belegt in
# tools/test_config_page.js im Repo Hui-161/Pebble, das die Seite unter
# beiden Kopfzeilen im Browser durchlaeuft.
/pebble/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://accounts.spotify.com; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# Traegt keine Version im Namen - also immer revalidieren, wie die
# uebrige App-Huelle.
/pebble/index.html
  Cache-Control: no-cache
/pebble/config.js
  Cache-Control: no-cache
/pebble/config.css
  Cache-Control: no-cache
