/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://tile.openstreetmap.org https://www.reeperbahnfestival.com; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# Leaflet ist versioniert eingecheckt und aendert sich nur bei Aktualisierung.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Programmdaten aendern sich taeglich.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# Der Service Worker darf NIE lange gecacht werden, sonst haengt die App
# auf einer alten Version fest.
/sw.js
  Cache-Control: no-cache
